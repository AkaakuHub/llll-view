{
  "name": "backend",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "build": "nest build",
    "start": "nest start",
    "start:dev": "pnpm kill-old && sleep 1 && nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "kill-old": "lsof -t -i :8000 | xargs -r kill -9 && while lsof -i :8000 >/dev/null 2>&1; do sleep 0.1; done",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "check": "biome check ./src --write",
    "db:generate": "pnpm exec prisma generate",
    "db:migrate": "pnpm exec prisma migrate dev",
    "db:studio": "pnpm exec prisma studio",
    "knip": "knip"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "@nestjs/cli": "^11.0.7",
    "@nestjs/common": "^11.1.3",
    "@nestjs/core": "^11.1.3",
    "@nestjs/platform-express": "^11.1.3",
    "@nestjs/swagger": "^11.2.0",
    "@prisma/client": "6.10.1",
    "dotenv": "^16.5.0",
    "dotenv-expand": "^11.0.7",
    "glob": "^11.0.0",
    "js-yaml": "^4.1.0",
    "music-tag-native": "^0.1.0",
    "p-retry": "^6.2.1",
    "prisma": "6.10.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "sharp": "^0.34.5",
    "swagger-ui-express": "^5.0.1"
  },
  "devDependencies": {
    "@biomejs/biome": "2.0.6",
    "@types/express": "^5.0.3",
    "@types/glob": "^8.1.0",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^24.0.7",
    "knip": "^5.61.3",
    "typescript": "^5.8.3"
  }
}
