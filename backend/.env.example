# do not use home dir alias (~), use absolute paths

# Database Configuration
DATABASE_URL="file:./dev.db"

# Server Configuration
PORT=8000
CORS_ORIGIN=http://localhost:5173,http://server-name:5173,http://100.100.100.100:5173

# Base Paths (expandable with dotenv-expand)
PROJECT_ROOT_PATH="/path/to/llll"
VIEW_ROOT_PATH="${PROJECT_ROOT_PATH}/llll-view"
TOOLS_ROOT_PATH="${PROJECT_ROOT_PATH}/llll-tools"

# Tool Binary Paths
VGMSTREAM_PATH="${TOOLS_ROOT_PATH}/vgmstream/build/cli/vgmstream-cli"
ASSETSTUDIO_CLI_PATH="${TOOLS_ROOT_PATH}/AssetStudio/AssetStudioCLI/bin/Release/net8.0/AssetStudioModCLI"
USMT_TOOLKIT_PATH="${TOOLS_ROOT_PATH}/UsmToolkit/UsmToolkit"

# System Environment Paths
# DOTNET_ROOT for AssetStudio (.NET 8.0 system install)
DOTNET_ROOT_ASSETSTUDIO="/usr/share/dotnet"
# DOTNET_ROOT for UsmToolkit (.NET 3.1 custom install)
DOTNET_ROOT_USMTOOLKIT="/path/to/dotnet"

# Log Level (debug, info, warn, error)
LOG_LEVEL=info

# Discord Webhook (optional)
DISCORD_WEBHOOK_URL="main=https://discord.com/api/webhooks/xxx,summary=https://discord.com/api/webhooks/yyy,music=https://discord.com/api/webhooks/zzz"
